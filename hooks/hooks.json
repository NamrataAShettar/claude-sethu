{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.sh",
              "prompt",
              "${CLAUDE_PLUGIN_ROOT}/hooks/sethu_hook.py"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.sh",
              "session",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"
            ]
          }
        ]
      }
    ]
  }
}
